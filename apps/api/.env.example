# Copy to apps/api/.env. Never commit .env.

# dev | test | prod. SECRET_KEY is mandatory unless this is "dev".
ENVIRONMENT=dev

# Relative SQLite paths are anchored at apps/api, not at the current directory.
DATABASE_URL=sqlite:///./data/aml.db
# To move to MySQL later (install the extra first: pip install -e ".[mysql]"):
# DATABASE_URL=mysql+pymysql://aml_user:change-me@localhost:3306/aml
# Optional assertion; when set it must match the DATABASE_URL backend.
# DATABASE_TYPE=sqlite
# Connections each process (the API, the worker) may hold open at once, and how long a request waits
# for one before it is refused with a 503. A request never holds two at the same time.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

# 32+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_TTL_MINUTES=60
# An account is refused for a while after this many failed sign-ins within this many seconds.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900
# How many reverse proxies in front of the API add to X-Forwarded-For (0 = none: the connection's
# address is the client's). Raise it only when they really are there; the header is otherwise
# whatever the client says, and it is what the audit log records as the client's address.
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=INFO

# --- Data providers ------------------------------------------------------------------------------
# All optional: a provider without a key is skipped. Keys are never logged or returned by the API.
#   python -m app.cli providers      shows what is configured (no network)
#   python -m app.cli probe <name>   makes one request to check a key works
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
TRONGRID_API_KEY=
HELIUS_API_KEY=
# BNB Smart Chain is not on Etherscan's free plan. Alchemy's free plan serves it (without internal
# transfers). Set this to true only if your Etherscan key is on Lite or above: Etherscan then becomes
# the first source for BNB too, and internal transfers are included.
ETHERSCAN_PAID_PLAN=false
# Bitcoin needs no key while developing: a public Esplora endpoint is used. Set this to use
# mempool.space or your own Esplora instance instead.
# ESPLORA_BASE_URL=https://blockstream.info/api
# Requests per second per provider, as JSON. Defaults are cautious (etherscan 3, alchemy 5,
# trongrid 5, helius 2, esplora 1); raise them to what your plan allows.
# PROVIDER_RATE_LIMITS={"etherscan": 3, "trongrid": 5}
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=3
# Consecutive failures that stop calls to a provider, and how long before one trial request.
PROVIDER_BREAKER_THRESHOLD=5
PROVIDER_BREAKER_COOLDOWN_SECONDS=30

# --- Reading address histories (python -m app.cli history, the FETCH_ADDRESS_HISTORY job) ----------
# The most provider requests one read may spend, and the most transfers it collects. A read that hits
# a limit stops cleanly and says how to resume.
HISTORY_REQUEST_BUDGET=200
HISTORY_MAX_ITEMS=5000
# Histories are stored. One read this recently is served as stored, asking no provider anything;
# an older one is brought up to date by reading only what is new. 0 means always check.
HISTORY_FRESH_SECONDS=300
# Keep the provider's raw answer for the transactions this platform decodes itself (Solana,
# Bitcoin), so a decoder fix can be applied to what was already read. Larger answers are not kept.
STORE_RAW_RESPONSES=true
RAW_MAX_BYTES=262144

# --- Address intelligence (python -m app.cli labels ...) --------------------------------------------
# OFAC's sanctions list is downloaded by `labels refresh` or the REFRESH_LABEL_SOURCE job.
INTEL_DOWNLOAD_TIMEOUT_SECONDS=120
INTEL_MAX_DOWNLOAD_BYTES=209715200
# The worker can bring label sources up to date by itself: name them here, comma separated
# (ofac_sdn, elliptic_binance; `labels sources` shows what there is). Empty means none, and then only
# `labels refresh` or a REFRESH_LABEL_SOURCE job does it. Name a source only if it is to be kept
# current: a source that goes stale (not confirmed for twice its refresh interval, two days for both)
# lowers the confidence of every screening, and one that has never been imported does not exist.
LABEL_REFRESH_SOURCES=
# How often the worker looks for a named source that is due, and so how often it tries again after a
# refresh that failed.
LABEL_REFRESH_TICK_SECONDS=3600
# Moov Watchman as a second opinion. Its HTTP service has NO authentication: point this only at an
# instance the backend alone can reach (the compose file's internal network), never a published port.
WATCHMAN_URL=
WATCHMAN_TIMEOUT_SECONDS=5

# --- Transaction graph (python -m app.cli graph, GET /api/v1/graph, FETCH_COUNTERPARTIES) -----------
# Safeguards against a graph that would cost millions of provider requests, not AML thresholds. A
# request may tighten them, never raise them.
GRAPH_DEFAULT_DEPTH=1
GRAPH_MAX_DEPTH=3
GRAPH_MAX_NODES=500
GRAPH_MAX_EDGES=2000
GRAPH_MAX_COUNTERPARTIES=25
GRAPH_WINDOW_DAYS=365
GRAPH_MAX_WINDOW_DAYS=3650
# Transfers read per address, and provider requests per investigation, when a graph fetches histories.
GRAPH_HISTORY_ITEMS=500
GRAPH_REQUEST_BUDGET=300
# A fan-in / fan-out: this many different counterparties within this many seconds.
GRAPH_FAN_THRESHOLD=10
GRAPH_FAN_WINDOW_SECONDS=86400
# A JSON file of bridge contracts (see app/graph/bridges.py). None ships with the platform.
BRIDGE_REGISTRY_FILE=

# --- Background worker (python -m app.worker) -----------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=2
# On SIGTERM / Ctrl+C running jobs get this long to finish before they are handed back.
WORKER_SHUTDOWN_GRACE_SECONDS=20
# A handler running longer than JOB_TIMEOUT_SECONDS is cancelled and the attempt counts as failed.
# A job RUNNING for JOB_LOCK_TIMEOUT_SECONDS is assumed to belong to a dead worker and is requeued.
# The lock timeout must be the larger of the two.
JOB_TIMEOUT_SECONDS=300
JOB_LOCK_TIMEOUT_SECONDS=900

# --- Monitored addresses and alerts (app/monitoring, /api/v1/monitoring, /api/v1/alerts) ----------
# The worker checks each monitored address on its own interval (any interval from the minimum below
# up to 30 days), brings its stored histories up to date through the providers, and raises an alert
# when the check finds something that was not there before. Every check spends provider requests,
# so an organization may watch only so many addresses.
MONITORING_MIN_INTERVAL_SECONDS=900
MONITORING_DEFAULT_INTERVAL_SECONDS=21600
MONITORING_MAX_ADDRESSES=100
# A score that rises by this much since the last check raises an alert even within one level.
MONITORING_SCORE_DELTA=15
# A report is stored when something changed, and anyway this often.
MONITORING_HEARTBEAT_DAYS=7
# The worker looks for addresses whose time has come every MONITORING_TICK_SECONDS and queues at most
# MONITORING_BATCH of them each time.
MONITORING_TICK_SECONDS=30
MONITORING_BATCH=200
# An address whose checks fail this many times in a row raises an alert of its own.
MONITORING_DEGRADED_AFTER=3
# An Alchemy Address Activity webhook (EVM chains) may call POST /api/v1/webhooks/alchemy; the event
# only makes an address that is already monitored be checked now rather than at its next turn. Set
# the signing key shown with the webhook in Alchemy's dashboard. Unset, the endpoint answers 404.
ALCHEMY_WEBHOOK_SIGNING_KEY=
WEBHOOK_MAX_BODY_BYTES=1000000
# The largest body any request to the API may carry (413 above it); the webhook has its own limit.
MAX_REQUEST_BODY_BYTES=1048576
