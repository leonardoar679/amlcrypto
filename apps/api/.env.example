# Copy to apps/api/.env. Never commit .env.

# dev | test | prod. SECRET_KEY is mandatory unless this is "dev".
ENVIRONMENT=dev

# Relative SQLite paths are anchored at apps/api, not at the current directory.
DATABASE_URL=sqlite:///./data/aml.db
# To move to MySQL later (install the extra first: pip install -e ".[mysql]"):
# DATABASE_URL=mysql+pymysql://aml_user:change-me@localhost:3306/aml
# Optional assertion; when set it must match the DATABASE_URL backend.
# DATABASE_TYPE=sqlite

# 32+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_TTL_MINUTES=60
LOG_LEVEL=INFO

# --- Data providers ------------------------------------------------------------------------------
# All optional: a provider without a key is skipped. Keys are never logged or returned by the API.
#   python -m app.cli providers      shows what is configured (no network)
#   python -m app.cli probe <name>   makes one request to check a key works
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
TRONGRID_API_KEY=
HELIUS_API_KEY=
# BNB Smart Chain is not on Etherscan's free plan. Alchemy's free plan serves it (without internal
# transfers). Set this to true only if your Etherscan key is on Lite or above: Etherscan then becomes
# the first source for BNB too, and internal transfers are included.
ETHERSCAN_PAID_PLAN=false
# Bitcoin needs no key while developing: a public Esplora endpoint is used. Set this to use
# mempool.space or your own Esplora instance instead.
# ESPLORA_BASE_URL=https://blockstream.info/api
# Requests per second per provider, as JSON. Defaults are cautious (etherscan 3, alchemy 5,
# trongrid 5, helius 2, esplora 1); raise them to what your plan allows.
# PROVIDER_RATE_LIMITS={"etherscan": 3, "trongrid": 5}
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=3
# Consecutive failures that stop calls to a provider, and how long before one trial request.
PROVIDER_BREAKER_THRESHOLD=5
PROVIDER_BREAKER_COOLDOWN_SECONDS=30

# --- Reading address histories (python -m app.cli history, the FETCH_ADDRESS_HISTORY job) ----------
# The most provider requests one read may spend, and the most transfers it collects. A read that hits
# a limit stops cleanly and says how to resume.
HISTORY_REQUEST_BUDGET=200
HISTORY_MAX_ITEMS=5000
# Histories are stored. One read this recently is served as stored, asking no provider anything;
# an older one is brought up to date by reading only what is new. 0 means always check.
HISTORY_FRESH_SECONDS=300
# Keep the provider's raw answer for the transactions this platform decodes itself (Solana,
# Bitcoin), so a decoder fix can be applied to what was already read. Larger answers are not kept.
STORE_RAW_RESPONSES=true
RAW_MAX_BYTES=262144

# --- Background worker (python -m app.worker) -----------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=2
# On SIGTERM / Ctrl+C running jobs get this long to finish before they are handed back.
WORKER_SHUTDOWN_GRACE_SECONDS=20
# A handler running longer than JOB_TIMEOUT_SECONDS is cancelled and the attempt counts as failed.
# A job RUNNING for JOB_LOCK_TIMEOUT_SECONDS is assumed to belong to a dead worker and is requeued.
# The lock timeout must be the larger of the two.
JOB_TIMEOUT_SECONDS=300
JOB_LOCK_TIMEOUT_SECONDS=900
