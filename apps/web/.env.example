# Copy to apps/web/.env.local. Never commit .env.local.
#
# Public origin of the site, without a trailing slash. Leave it empty until the real domain exists:
# while it is empty the site publishes no canonical or Open Graph URL.
#
# Everything prefixed NEXT_PUBLIC_ is embedded in the browser bundle, so nothing secret belongs here.
# Provider API keys live in apps/api/.env and never reach the frontend.
NEXT_PUBLIC_SITE_URL=
