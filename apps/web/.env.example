# Copy to apps/web/.env.local. Never commit .env.local.
#
# Where the platform's API (apps/api) is. This is read on the server only: the browser never talks to
# the API directly. It sends its requests to this site, and this site forwards the permitted ones to
# the API with the signed-in user's token, which it keeps in an httpOnly cookie. Defaults to the
# address a local `uvicorn` listens on. In Docker or production use the API's internal address.
BACKEND_URL=http://127.0.0.1:8000
#
# Public origin of the site, without a trailing slash. Leave it empty until the real domain exists:
# while it is empty the site publishes no canonical or Open Graph URL.
#
# Everything prefixed NEXT_PUBLIC_ is embedded in the browser bundle, so nothing secret belongs here.
# Provider API keys live in apps/api/.env and never reach the frontend.
NEXT_PUBLIC_SITE_URL=
